DATABASE_URL=postgresql://user:password@localhost:5432/bubble

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-byte-hex-string

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# OpenAI key for AI features (context analysis, poll generation)
OPENAI_API_KEY=sk-...

# Secret for POST /demo/reset — pick any random string
DEMO_RESET_SECRET=change-me
