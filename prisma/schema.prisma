generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  phone        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdGroups  Group[]         @relation("GroupCreator")
  createdEvents  Event[]         @relation("EventCreator")
  groupMembers   GroupMember[]
  messages       Message[]       @relation("MessageSender")
  refreshTokens  RefreshToken[]
  userAttributes UserAttribute[]
  polls          polls[]
  votes          votes[]

  @@map("users")
}

model Group {
  id        Int      @id @default(autoincrement())
  creatorId Int      @map("creator_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  name      String?

  creator      User          @relation("GroupCreator", fields: [creatorId], references: [id])
  groupMembers GroupMember[]
  events       Event[]

  @@map("groups")
}

model Event {
  id        Int      @id @default(autoincrement())
  groupId   Int      @map("group_id")
  creatorId Int      @map("creator_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  name        String
  location    String?
  eventTime   DateTime? @map("event_time") @db.Timestamptz(6)
  description String?

  group    Group     @relation(fields: [groupId], references: [id])
  creator  User      @relation("EventCreator", fields: [creatorId], references: [id])
  messages Message[]
  polls    polls[]

  @@map("events")
}

model GroupMember {
  id       Int       @id @default(autoincrement())
  userId   Int       @map("user_id")
  groupId  Int       @map("group_id")
  joinedAt DateTime? @map("joined_at") @db.Timestamptz(6)
  role     String?

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
  @@map("group_members")
}

model Message {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  senderId  Int      @map("sender_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event           Event                    @relation(fields: [eventId], references: [id])
  sender          User                     @relation("MessageSender", fields: [senderId], references: [id])
  contextEvidence MessageContextEvidence[]
  viewerRelevance MessageViewerRelevance[]

  @@map("messages")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserAttribute {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  key       String
  score     Float
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_attributes")
}

model EmojiType {
  id           Int    @id @default(autoincrement())
  name         String @unique
  emoji        String
  description  String
  defaultScore Float  @default(0.0) @map("default_score")

  evidence MessageContextEvidence[]

  @@map("emoji_types")
}

model MessageContextEvidence {
  id           Int      @id @default(autoincrement())
  messageId    Int      @map("message_id")
  emojiTypeId  Int?     @map("emoji_type_id")
  attributeKey String?  @map("attribute_key")
  direction    String?
  confidence   Float
  displayQuote String   @map("display_quote") @db.VarChar(120)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emojiType EmojiType? @relation(fields: [emojiTypeId], references: [id])

  @@map("message_context_evidence")
}

model MessageViewerRelevance {
  id           Int    @id @default(autoincrement())
  messageId    Int    @map("message_id")
  attributeKey String @map("attribute_key")
  score        Float

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, attributeKey])
  @@index([attributeKey, score])
  @@map("message_viewer_relevance")
}

model options {
  id          Int     @id @default(autoincrement())
  poll_id     Int?
  option_text String?
  polls       polls?  @relation(fields: [poll_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  votes       votes[]
}

model polls {
  id              Int       @id @default(autoincrement())
  event_id        Int?
  user_id         Int?
  question        String?
  created_at      DateTime? @db.Timestamptz(6)
  expires_at      DateTime? @db.Timestamptz(6)
  is_active       Boolean?
  allows_multiple Boolean?

  options options[]
  events  Event?    @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users   User?     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  votes   votes[]

  @@map("polls")
}

model votes {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  poll_id    Int?
  option_id  Int?
  created_at DateTime? @db.Timestamptz(6)
  options    options?  @relation(fields: [option_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  polls      polls?    @relation(fields: [poll_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      User?     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
